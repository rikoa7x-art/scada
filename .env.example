# ===================================================
# PRODIST SCADA - ENVIRONMENT CONFIGURATION TEMPLATE
# Salin file ini menjadi '.env' lalu isi API key Anda
# ===================================================

# NVIDIA NIM API Key untuk AI Vision (meta/llama-3.2-11b-vision-instruct)
# Dapatkan API key di https://build.nvidia.com
NVIDIA_API_KEY=your_nvidia_nim_api_key_here

# Port HTTP Server SCADA (Default: 3000)
PORT=3000

# Supabase Cloud Database & Realtime Sync
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_jwt_key_here
